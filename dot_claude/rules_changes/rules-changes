#!/usr/bin/env ruby
# rules-changes: a register of edits to Claude's shared instructions (rules files, CLAUDE.md, hooks).
# Each running session sees the edits made since it started on its next prompt, via the UserPromptSubmit hook.
#
#   rules-changes add --file PATH [--file PATH…] [--section NAME] --gist TEXT [--commit SHA] [--session NAME]
#   rules-changes prompt-hook       UserPromptSubmit hook: hook JSON on stdin, unseen changes out as context
#   rules-changes pending           unsent changes, one per line
#   rules-changes digest            a broadcast message, for when James asks for one, then a last line "IDS: …"
#   rules-changes mark-sent ID…     record those changes as broadcast
#
# Delivering on the next prompt costs nothing extra: a broadcast wakes every idle session and makes it
# re-cache its whole context, which cost ~18M tokens a week when the digest ran twice a day.
#
# Kept compatible with macOS's /usr/bin/ruby 2.6.
require 'json'
require 'time'
require 'date'
require 'optparse'
require 'securerandom'
require 'fileutils'

REGISTER = ENV.fetch('RULES_CHANGES_FILE', File.expand_path('~/.claude/rules-changes.jsonl'))
SEEN_DIR = ENV.fetch('RULES_CHANGES_SEEN_DIR', File.expand_path('~/.claude/rules-changes-seen'))

def die(msg)
  warn "rules-changes: #{msg}"
  exit 1
end

def now
  text = ENV['RULES_CHANGES_NOW'].to_s
  return Time.now if text.empty?

  m = text.match(/\A(\d{4})-(\d\d)-(\d\d) (\d\d):(\d\d)\z/) or die("can't parse RULES_CHANGES_NOW #{text.inspect}")
  Time.local(*m.captures.map(&:to_i))
end

def with_register
  FileUtils.mkdir_p(File.dirname(REGISTER))
  File.open(REGISTER, File::RDWR | File::CREAT, 0o600) do |f|
    f.flock(File::LOCK_EX)
    rows = f.read.lines.reject { |l| l.strip.empty? }.map { |l| JSON.parse(l) }
    result = yield rows
    f.rewind
    f.truncate(0)
    rows.each { |r| f.puts(JSON.generate(r)) }
    result
  end
end

def add(argv)
  opts = { 'files' => [] }
  OptionParser.new do |o|
    o.on('--file PATH') { |v| opts['files'] << v }
    o.on('--section NAME') { |v| opts['section'] = v }
    o.on('--gist TEXT') { |v| opts['gist'] = v }
    o.on('--commit SHA') { |v| opts['commit'] = v }
    o.on('--session NAME') { |v| opts['session'] = v }
  end.parse!(argv)
  die 'add needs at least one --file' if opts['files'].empty?
  die 'add needs --gist' if opts['gist'].to_s.empty?

  row = opts.merge('id' => SecureRandom.hex(3), 'at' => now.iso8601, 'sent_at' => nil)
  with_register { |rows| rows << row }

  puts "registered #{row['id']}; each session sees it on its next prompt"
end

def pending_rows
  with_register { |rows| rows.reject { |r| r['sent_at'] } }
end

def pending
  pending_rows.each { |r| puts "#{r['id']}  #{r['at']}  #{r['files'].join(', ')}  #{r['gist']}" }
end

# When this session last saw the register: its marker, else when its transcript started (rules load
# then), else now, so a session with no transcript isn't shown the whole history.
def seen_since(marker, transcript)
  return Time.parse(File.read(marker).strip) if File.exist?(marker)

  first = File.exist?(transcript.to_s) && File.foreach(transcript).lazy.map { |l| (JSON.parse(l)['timestamp'] rescue nil) }.find(&:itself)
  first ? Time.parse(first) : now
end

def prompt_hook
  input = JSON.parse(STDIN.read) rescue {}
  session = input['session_id'].to_s
  return if session.empty? || session.include?('/')

  FileUtils.mkdir_p(SEEN_DIR)
  marker = File.join(SEEN_DIR, session)
  since = seen_since(marker, input['transcript_path'])
  File.write(marker, now.iso8601)
  rows = with_register { |all| all.select { |r| Time.parse(r['at']) > since } }
  return if rows.empty?

  text = "Instruction files changed since this session last loaded them. Read the parts named below " \
         "and follow the new versions from now on.\n#{describe(rows)}"
  puts JSON.generate('hookSpecificOutput' => { 'hookEventName' => 'UserPromptSubmit', 'additionalContext' => text })
end

def describe(rows)
  rows.group_by { |r| r['files'].join(', ') }.map do |files, changes|
    lines = changes.map do |r|
      where = r['section'] ? "§ #{r['section']}: " : ''
      tail = [r['commit'], r['session'] && "from #{r['session']}"].compact.join(', ')
      "- #{where}#{r['gist']}#{tail.empty? ? '' : " (#{tail})"}"
    end
    "\n#{files}\n#{lines.join("\n")}"
  end.join("\n")
end

def digest
  rows = pending_rows
  return puts('nothing pending') if rows.empty?

  puts 'Rules digest: instruction files changed. Re-read the parts named below, ' \
       'and follow the new versions from now on. Reply only if something conflicts with work in progress.'
  puts describe(rows)
  puts "IDS: #{rows.map { |r| r['id'] }.join(' ')}"
end

def mark_sent(ids)
  die 'mark-sent needs ids' if ids.empty?
  stamp = now.iso8601
  marked = with_register { |rows| rows.select { |r| ids.include?(r['id']) }.each { |r| r['sent_at'] = stamp }.size }
  puts "marked #{marked} sent"
end

case (cmd = ARGV.shift)
when 'add' then add(ARGV)
when 'pending' then pending
when 'digest' then digest
when 'mark-sent' then mark_sent(ARGV)
when 'prompt-hook' then prompt_hook
else
  puts File.readlines(__FILE__)[1, 10].map { |l| l.sub(/\A# ?/, '') }.join
  exit(cmd.nil? || %w[-h --help help].include?(cmd) ? 0 : 1)
end
