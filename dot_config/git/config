[includeIf "gitdir/i:~/code/"]
	path = ~/code/personal/dot-files/dot_config/git/credentials
; override the above for github repos
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
	path = ~/code/personal/dot-files/dot_config/git/gh_credentials
[includeIf "gitdir/i:~/codez/"]
	path = ~/codez/dot-files/dot_config/git/credentials
[color]
	diff = auto
	status = auto
	branch = auto
[branch]
	autosetupmerge = true
[core]
	safecrlf = warn
	autocrlf = input
	editor = "code --wait" # mvimf
	whitespace = fix
	excludesfile = /Users/james.ferguson/.gitignore_global
	pager = delta
[push]
	default = simple
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	autoStash = true
[achievement]
	upload = true
[alias]
	stus = status
	s = status
	st = status
#	ci = commit
	cm = commit
#	c = commit
#	br = branch
#	b = branch
#	co = checkout
	ch = checkout
	; diff = diff --word-diff
	df = diff ; --word-diff
#	lg = log
#	l = log
	lgp = log -p --word-diff
	lggo = log --graph --decorate --pretty=oneline --abbrev-commit
	lggoa = log --graph --decorate --pretty=oneline --abbrev-commit --all
	wc = whatchanged
#	w = whatchanged
	mg = merge --no-ff
	merge = merge --no-ff
#	ad = add
#	a = add
	adp = add -p
	mt = mergetool
#	ps = push
#	ph = push
#	pl = pull
#	sh = stash
	au = update-index --assume-unchanged
	assume-unchanged = update-index --assume-unchanged
	uiau = update-index --assume-unchanged
	force-ignore = update-index --assume-unchanged
	fi = update-index --assume-unchanged
	noau = update-index --no-assume-unchanged
	no-assume-unchanged = update-index --no-assume-unchanged
	unforce-ignore = update-index --no-assume-unchanged
	unfi = update-index --no-assume-unchanged
	ls-force-ignored = !git ls-files -v | grep ^[a-z]
	lsfi = !git ls-files -v | grep ^[a-z]
	ls-assume-unchanged = !git ls-files -v | grep ^[a-z]
	lsau = !git ls-files -v | grep ^[a-z]
	cb = rev-parse --symbolic-full-name --abbrev-ref HEAD
	gp = !git push --set-upstream origin HEAD:$(git cb)
	gup = !git fetch --prune origin && git rebase -r origin/$(git cb)
	logline = log --graph --pretty=format:'%C(yellow)%h%Creset -%C(red)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
[git-up "bundler"]
	check = true
	autoinstall = true
[git-up "fetch"]
	prune = true
[merge]
	tool = smerge
	conflictStyle = zdiff3
[mergetool]
	keepBackup = false
[filter "media"]
	required = true
	clean = git media clean %f
	smudge = git media smudge %f
[credential]
	helper = osxkeychain
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
; [url "git@github.com:blake-education/"]
;   insteadOf = https://github.com/blake-education/
[init]
	defaultBranch = main
[github]
	user = james.ferguson
[diff]
	tool = smerge
[difftool "smerge"]
	cmd = smerge diff "$LOCAL" "$REMOTE"
[mergetool "smerge"]
	cmd = smerge mergetool "$BASE" "$LOCAL" "$REMOTE" -o "$MERGED"
	trustExitCode = "true"
[interactive]
	diffFilter = delta --color-only
[delta]
	features = unobtrusive-line-numbers decorations 
	navigate = true # n/N to navigate between diff chunks
	line-numbers = true
	tabs = 2
[delta "unobtrusive-line-numbers"]
	line-numbers = true
	line-numbers-minus-style = "#444444"
	line-numbers-zero-style = "#444444"
	line-numbers-plus-style = "#444444"
	line-numbers-left-format = "{nm:>4}┊"
	line-numbers-right-format = "{np:>4}│"
	line-numbers-left-style = blue
	line-numbers-right-style = blue
[delta "decorations"]
	commit-decoration-style = bold yellow box ul
	file-style = bold yellow
	file-decoration-style = none
	hunk-header-decoration-style = yellow box
