# Note: work-specific tools (puma-dev, redis, localstack, foreman, atlassian/acli,
# rollbar-cli, overitall, jiratui, docker-buildx, libxmlsec1, shared-mime-info,
# unixodbc, wxmac, pkg-config, etc.) live in the work overlay repo (dot-files-private/work/).
# Personal-only tools (xscreensaver, signal, stremio, etc.) will move to
# dot-files-private/personal/ once that overlay repo is set up.

tap 'homebrew/services'

# ── Core tools ────────────────────────────────────────────────────────────────
brew 'bat'          # cat with nice formatting
brew 'blueutil'     # turn off bluetooth on sleep (used w sleepwatcher)
brew 'btop'         # interactive process viewer
brew 'cheat'        # cheatsheets on commands
brew 'csvtk'        # count, re/format, search, edit, transform and plot CSVs
brew 'curl'
brew 'fortune'
brew 'fzf'          # fuzzy finder — Ctrl-R history search, file picker
brew 'gh'
brew 'git'
brew 'git-delta'    # better git diffs with syntax highlighting
brew 'gitleaks'     # scan git repos for secrets
brew 'gpg'          # commit signing and secret encryption
brew 'herdr'        # manage multiple LLM conversations in tmux-like sessions
brew 'httpie'       # curl with a nicer interface
brew 'jq'           # JSON parser
brew 'mas'          # Mac App Store CLI, crippled by Apple
brew 'mise'         # dev runtime manager (replaces asdf)
brew 'pbzip2'       # multi-core bzip2
brew 'pigz'         # multi-core gzip
brew 'pipx'         # run Python tools in isolated environments
brew 'postgresql@15', restart_service: :changed, link: true, conflicts_with: ['postgresql']
brew 'ripgrep'      # grep with Rust
brew 'sleepwatcher', restart_service: :changed  # run commands on sleep and wake
brew 'tldr'         # cheatsheets on commands
brew 'up'           # write CLI pipes with live preview
brew 'whalebrew'    # brew for dockerized tools
brew 'xdg-ninja'    # find files that can be converted to XDG spec
brew 'zsh-autosuggestions'           # fish-like autosuggestions
brew 'zsh-history-substring-search' # up/down arrow searches history by substring
brew 'zsh-you-should-use'            # alias reminders when you use the long form

