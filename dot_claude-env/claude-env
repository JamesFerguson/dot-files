#!/bin/sh
# Claude Environment Configuration
# This file is sourced by Claude/VSCode to provide access to shell environment

# Set file descriptor limit
ulimit -n 8192 2>/dev/null

# XDG base directory specification
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# Tool configurations (XDG-compliant)
export ACKRC="$XDG_CONFIG_HOME/ack/ackrc"
export AWS_SHARED_CREDENTIALS_FILE="$XDG_CONFIG_HOME/aws/credentials"
export AWS_CONFIG_FILE="$XDG_CONFIG_HOME/aws/config"
export AZURE_CONFIG_DIR="$XDG_DATA_HOME/azure"
export BUNDLE_USER_CONFIG="$XDG_CONFIG_HOME/bundle/config"
export BUNDLE_USER_CACHE="$XDG_CACHE_HOME/bundle"
export BUNDLE_USER_PLUGIN="$XDG_DATA_HOME/bundle"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
export GEM_SPEC_CACHE="$XDG_CACHE_HOME/gem"
export INPUTRC="$XDG_CONFIG_HOME/readline/inputrc"
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export RUBOCOP_CONFIG="$XDG_CONFIG_HOME/rubocop/config.yml"

# Let Claude Code run `brew upgrade` itself when a new version ships — Homebrew
# installs don't auto-update, so this opts the CLI into doing it in the background.
export CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE=1

# Determine code directory based on hostname
if [ -n "$HOST" ] && echo "$HOST" | grep -q "fz-"; then
  CODE_DIR="$HOME/code"
else
  CODE_DIR="$HOME/codez"
fi

export CODE_DIR
export DOT_FILES_DIR="$CODE_DIR/personal/dot-files"

# Go-lang setup
export GOPATH="$HOME/go"
GOPATHS="${GOPATH}/bin"

# PATH configuration - comprehensive path for tool access
export PATH="\
$XDG_DATA_HOME/mise/shims:\
$HOME/bin:\
$CODE_DIR/git-achievements:\
/usr/local/bin:\
$HOME/.local/bin:\
/opt/homebrew/bin:\
/opt/homebrew/sbin:\
/opt/homebrew/opt/libpq/bin:\
/usr/local/sbin:\
/usr/bin:\
/bin:\
/usr/sbin:\
/sbin:\
$XDG_DATA_HOME/gem/bin:\
$GOPATHS:\
$HOME/.yarn/bin:\
$HOME/.yarn/dist/bin:\
$XDG_CONFIG_HOME/yarn/global/node_modules/.bin:\
$PATH"

# Locale settings
export LC_ALL='en_US.UTF-8'
export LANG='en_US.UTF-8'
export LC_CTYPE='C'
export TZ="Australia/Sydney"

# Standard configuration
export PAGER='less'
export HOSTNAME="${HOSTNAME:-$(hostname 2>/dev/null)}"

# Machine-local secrets, not committed (e.g. NEW_RELIC_API_KEY for the MCP server)
[ -f "$HOME/.claude-env.local" ] && . "$HOME/.claude-env.local"
