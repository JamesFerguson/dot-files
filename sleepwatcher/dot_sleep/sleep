#!/bin/bash

# -e to interpret escape chars
HOOK_LOG="$HOME/Library/Logs/sleepwatcher.log" # not /tmp, which a restart wipes
echo -e "\nRunning .sleep script $(date)" >> "$HOOK_LOG"

# echo -e  "$(env)" >> "$HOOK_LOG"

# Log sleep event to work from home CSV
LOG_FILE="$HOME/Documents/Financial/Tax/work_from_home_log.csv"
mkdir -p "$(dirname "$LOG_FILE")"
echo "$(date '+%Y-%m-%d'),$(date '+%H:%M:%S'),Sleep" >> "$LOG_FILE"

# Script may run in a restricted env, doesn't get /etc/zshenv vars
HOMEBREW_PREFIX='/opt/homebrew'

# $HOMEBREW_PREFIX/bin/blueutil -p 0
$HOMEBREW_PREFIX/bin/blueutil --disconnect "70-5a-6f-6b-66-2f" # EarFun Air Pro 4

echo -e  "Finished .sleep script\n\n" >> "$HOOK_LOG"