#!/bin/bash
# Keeps the Mac and display awake until 17:20 on weekdays, but only on the home network.
# Run from the sleepwatcher wake hook. A script rather than an Amphetamine schedule + Wi-Fi
# trigger: Amphetamine's Wi-Fi check needs Location Services and nags endlessly on macOS 27.
#
# macOS hides the Wi-Fi name (SSID) from anything without location permission, so home is
# recognised by the router instead: the FRITZ!Box's TR-064 description lists device UUIDs that
# end in its own MAC address. That ID lives in ~/.config/keep-awake/home-router-id (not in the
# repo). Write it once from home:
#   curl -s http://192.168.178.1:49000/tr64desc.xml | grep -o -m1 '[0-9A-F]\{12\}</UDN>' | cut -c1-12 \
#     > ~/.config/keep-awake/home-router-id
#
# macOS also wakes fully for a few seconds with nobody there (a notification, network upkeep),
# often with the lid shut. Those wakes run the hook too, so it only goes ahead once someone
# touches the keyboard or trackpad after the wake.
#
# DRY_RUN=1 prints the decision without starting caffeinate. START_TIME=HH:MM, END_TIME=HH:MM,
# DAY_OF_WEEK=1-7 and INPUT_WAIT_SECS override the defaults for testing.

START_TIME=${START_TIME:-06:00}
END_TIME=${END_TIME:-17:20}
INPUT_WAIT_SECS=${INPUT_WAIT_SECS:-600}
ID_FILE="$HOME/.config/keep-awake/home-router-id"
PID_FILE="/tmp/keep-awake-at-home.pid"
WAITER_PID_FILE="/tmp/keep-awake-at-home.waiter.pid"
# A dry run leaves the real caffeinate alone.
[[ -n $DRY_RUN ]] && PID_FILE+=.dry-run WAITER_PID_FILE+=.dry-run
log() { echo "keep-awake $(date +%H:%M:%S): $*"; }
at() { date -j -f '%H:%M:%S' "$1:00" +%s; }

# A fresh wake replaces whatever an earlier wake started: its caffeinate, and a run that went
# back to sleep while still waiting for input.
for f in "$PID_FILE" "$WAITER_PID_FILE"; do
  [[ -f $f ]] && kill "$(cat "$f")" 2>/dev/null
  rm -f "$f"
done
echo $$ > "$WAITER_PID_FILE"
trap '[[ $(cat "$WAITER_PID_FILE" 2>/dev/null) == "$$" ]] && rm -f "$WAITER_PID_FILE"' EXIT

(( ${DAY_OF_WEEK:-$(date +%u)} <= 5 )) || { log "weekend, skipping"; exit 0; }

woke=$(date +%s)
(( woke >= $(at "$START_TIME") )) || { log "before $START_TIME, skipping"; exit 0; }
(( woke < $(at "$END_TIME") )) || { log "past $END_TIME, skipping"; exit 0; }

home_id=$(cat "$ID_FILE" 2>/dev/null)
[[ -n $home_id ]] || { log "no $ID_FILE, skipping"; exit 0; }

# Seconds since the last keyboard or trackpad event.
hid_idle() { /usr/sbin/ioreg -c IOHIDSystem | awk '/HIDIdleTime/ {print int($NF / 1e9); exit}'; }

# Input in the first few seconds doesn't count: the wake itself can reset the idle timer.
until (( $(hid_idle) < $(date +%s) - woke - 5 )); do
  if (( $(date +%s) - woke >= INPUT_WAIT_SECS )); then
    log "no keyboard or trackpad input in ${INPUT_WAIT_SECS}s since the wake, skipping"
    exit 0
  fi
  sleep 5
done

# Wi-Fi can take a while to rejoin after wake, so keep asking the router for a minute.
at_home=0
for _ in {1..12}; do
  router=$(/sbin/route -n get default 2>/dev/null | awk '/gateway:/ {print $2}')
  if [[ -n $router ]] && /usr/bin/curl -s -m 3 "http://$router:49000/tr64desc.xml" | grep -q -i "$home_id"; then
    at_home=1; break
  fi
  sleep 5
done
(( at_home )) || { log "not on the home network, skipping"; exit 0; }

secs=$(( $(at "$END_TIME") - $(date +%s) ))
if [[ -n $DRY_RUN ]]; then
  log "would keep awake for ${secs}s (until $END_TIME)"
  exit 0
fi
/usr/bin/caffeinate -d -i -t "$secs" &
echo $! > "$PID_FILE"
log "keeping awake until $END_TIME (caffeinate pid $!)"
