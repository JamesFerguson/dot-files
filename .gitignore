.DS_store
.idea/
# .zcompdump - some kind of precompile/caching for zshrc
.zcompdump
*.swp

dot_bundle/cache
dot_config/aws/credentials
dot_config/git/credentials
dot_config/git/gh_credentials
dot_config/zsh/.zprezto
dot_config/zsh/.zsh_history
dot_config/zsh/.zsh_sessions
dot_config/zsh/.zcompdump*
dot_config/zsh/device-type.zsh

# gh's account differs per machine: the private overlay installer links in work/ or personal/ gh/hosts.yml.
dot_config/gh/hosts.yml
dot_config/gh/hosts.yml.bak.*

# Private SwiftBar plugins symlinked in by the private overlay installer.
# They point into dot-files-private and must not be committed to the public repo.
swiftbar/btcmarkets.1h.sh
swiftbar/shiller-pe.4h.sh
dot_vim/.netrwhist
dot_vim/bundle

schedule/log
schedule/vendor

tweaks/shimmed_env_rust/target
# Conversation notes live in the private work-dot-files repo (symlinked)
CLAUDE_convos
