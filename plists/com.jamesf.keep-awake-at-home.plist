<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jamesf.keep-awake-at-home</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-fc</string>
    <string>exec "$HOME/code/personal/dot-files/sleepwatcher/keep-awake-at-home"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- The script exits once caffeinate is running; without this launchd kills caffeinate with it. -->
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/sleepwatcher.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/sleepwatcher.log</string>
</dict>
</plist>
