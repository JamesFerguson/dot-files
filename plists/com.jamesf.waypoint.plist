<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jamesf.waypoint</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-fc</string>
    <!-- Stable Waypoint: the release bin/promote built from the newest v* tag, at https://waypoint.test (port 4000). env holds DATABASE_URL, SECRET_KEY_BASE and the rest. It shells out to gh, acli, claude and pr-task, which all find their logins on their own. -->
    <string>export PATH="$HOME/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin" LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8; set -a; source "$HOME/.local/share/waypoint/env" || exit 1; set +a; exec "$HOME/.local/share/waypoint/current/bin/waypoint" start >> "$HOME/Library/Logs/waypoint.log" 2>&amp;1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restarts it if it dies, so killing it is also how to restart it. -->
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
